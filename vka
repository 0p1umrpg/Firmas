@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Inter:wght@400;500;600&display=swap');

.vka{
  position:relative;
  width:350px;
  height:250px;
  margin:0 auto;
  overflow:hidden;
  box-sizing:border-box;
  background:#111;
  border:6px solid #1f1c1c;
  box-shadow:0 0 0 1px rgba(255,255,255,.08) inset;
}

.vka br{display:none}

.vka-img{
  position:absolute;
  inset:0;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  transition:transform .8s ease,filter .8s ease;
}

.vka-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.18);
  transition:background .7s ease;
}

.vka-frame{
  position:absolute;
  inset:14px;
  border:2px solid rgba(255,255,255,.72);
  pointer-events:none;
  z-index:3;
}

.vka-copy{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  z-index:4;
  width:240px;
  text-align:center;
}

.vka-title{
  display:block;
  font-family:'Cinzel',serif;
  font-size:42px;
  font-weight:500;
  line-height:1;
  letter-spacing:4px;
  text-transform:uppercase;
  color:#fff;
  text-shadow:0 2px 10px rgba(0,0,0,.65);
  transition:transform .6s ease,opacity .6s ease;
}

.vka-sub{
  display:block;
  margin:14px auto 0;
  width:max-content;
  max-width:200px;
  overflow:hidden;
  white-space:nowrap;
  color:#fff;
  font-family:'Inter',Arial,sans-serif;
  font-size:11px;
  font-weight:600;
  letter-spacing:3px;
  text-transform:uppercase;
  text-shadow:0 2px 8px rgba(0,0,0,.6);
  opacity:0;
  border-right:1px solid rgba(255,255,255,.9);
}

.vka:hover .vka-img{
  transform:scale(1.03);
  filter:brightness(.78);
}

.vka:hover .vka-overlay{
  background:rgba(0,0,0,.28);
}

.vka:hover .vka-title{
  transform:translateY(-6px);
}

.vka:hover .vka-sub{
  opacity:1;
  animation:vka-type 1.6s steps(8,end) forwards, vka-caret .7s step-end infinite;
}

@keyframes vka-type{
  from{width:0}
  to{width:9.2ch}
}

@keyframes vka-caret{
  50%{border-color:transparent}
}
